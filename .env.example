# Copy to .env for local paper/signal-only runs. Never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_CHAT_ID=

# Risk and market-data filters
MAX_POSITION_USD=200
MIN_QUOTE_VOLUME_USDT=5000000

# State files
SIGNALS_FILE=signals.json
USERS_FILE=users.json

# Optional panel GitHub integration (never put a PAT in this file in a shared repo)
GH_REPO=mostafasp209-ship-it/crypto-signal-bot
GH_WORKFLOW=bot.yml
GH_BRANCH=main
